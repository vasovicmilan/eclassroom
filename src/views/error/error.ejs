<%- include('../includes/head', { 
    title: locals.title || 'Greška', 
    pageDescription: locals.message || 'Došlo je do greške', 
    pageStyles: 'pages/error.css' 
}) %>

<%- include('../includes/navigation', { active: '' }) %>

<main class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="error-card border rounded-3 shadow-sm p-5 bg-white">
                <div class="error-status mb-4">
                    <span class="display-1 fw-bold text-danger"><%= locals.status || '404' %></span>
                </div>

                <h1 class="h3 mb-3"><%= locals.title || 'Greška' %></h1>
                <p class="text-muted mb-4"><%= locals.message || 'Došlo je do neočekivane greške.' %></p>

                <% if (locals.errorId) { %>
                    <p class="small text-muted mb-4">ID greške: <%= errorId %></p>
                <% } %>

                <% if (locals.stack && process.env.NODE_ENV === 'development') { %>
                    <details class="mt-4 text-start">
                        <summary class="text-muted">Detalji greške</summary>
                        <pre class="bg-light p-3 rounded mt-2 small"><code><%= stack %></code></pre>
                    </details>
                <% } %>

                <div class="mt-4">
                    <a href="/" class="btn btn-primary me-2">Početna stranica</a>
                    <button onclick="history.back()" class="btn btn-outline-secondary">Nazad</button>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../includes/end') %>