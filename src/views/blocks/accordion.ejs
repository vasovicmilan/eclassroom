<% const accId = block.id || 'accordion'; %>
<div class="accordion" id="<%= accId %>"><% block.items.forEach((cat, idx) => { %><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button <%= idx !== 0 ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#<%= accId %>-<%= idx %>"><%= cat.title %></button></h2><div id="<%= accId %>-<%= idx %>" class="accordion-collapse collapse <%= idx === 0 ? 'show' : '' %>" data-bs-parent="#<%= accId %>"><div class="accordion-body"><ul class="list-group list-group-flush"><% cat.items.forEach(it => { %><li class="list-group-item"><code><%= it.code %></code> – <%- it.text %><% if (it.examples) { %><br><small class="text-muted"><%- it.examples.join(', ') %></small><% } %></li><% }) %></ul></div></div></div><% }) %></div>
