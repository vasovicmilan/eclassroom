<%# layout "grid": male kartice sa ikonom (4 u redu); layout "pair": dve velike svetle kartice sa naslovom i opisom %>
<% const layout = block.layout || 'grid'; %>
<% if (layout === 'pair') { %>
<div class="row g-3"><% block.items.forEach(item => { %><div class="col-md-6"><div class="card h-100 bg-light"><div class="card-body"><h3 class="h5"><%- (item.icon ? item.icon + ' ' : '') + item.title %></h3><% if (item.text) { %><p class="mb-2"><%- item.text %></p><% } %><% if (item.items) { %><ul class="mb-2"><% item.items.forEach(li => { %><li><%- li %></li><% }) %></ul><% } %><% if (item.example) { %><p class="small text-muted mb-0">Npr.: <%- item.example %></p><% } %></div></div></div><% }) %></div>
<% } else { %>
<% const colClass = { 2: 'col-sm-6', 3: 'col-sm-6 col-lg-4', 4: 'col-sm-6 col-md-4 col-lg-3' }[block.columns || 4] || 'col-sm-6 col-md-4 col-lg-3'; %>
<div class="row g-3"><% block.items.forEach(item => { %><div class="<%= colClass %>"><div class="card h-100 text-center"><div class="card-body"><% if (item.icon) { %><div class="fs-1"><%= item.icon %></div><% } %><strong><%- item.title %></strong><% if (item.text) { %><span class="small d-block"><%- item.text %></span><% } %></div></div></div><% }) %></div>
<% } %>
