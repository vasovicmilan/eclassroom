<div class="d-flex flex-wrap align-items-center justify-content-center gap-2 my-3"><% block.nodes.forEach((node, i) => { %><% if (i > 0) { %><span class="fs-4 text-muted">→</span><% } %><div class="card card-body text-center py-2 px-3"><strong><%= node.title %></strong><% if (node.sub) { %><small class="text-muted"><%= node.sub %></small><% } %></div><% }) %></div>
